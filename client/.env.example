# Copy to client/.env to override. All optional.

# Dev server port (default 5290) and where /api is proxied to (default http://localhost:5000)
# CLIENT_PORT=5290
# API_TARGET=http://localhost:5000

# Alternative live exchange-rate feed. Must return JSON like { "rates": { "KES": 129.4 } }.
# VITE_FX_URL=https://open.er-api.com/v6/latest/USD
