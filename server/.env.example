# Copy this file to server/.env and fill in real values. server/.env is gitignored.
PORT=5000
# MongoDB Atlas (or local) connection string. Use a user limited to readWrite on one database.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/spendscope?retryWrites=true&w=majority
# Long random string used to sign login cookies, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
# Browser origin allowed to call the API (the Vite dev server, port 5290)
CLIENT_ORIGIN=http://localhost:5290

# Optional ------------------------------------------------------------
# Set to 1 when the API runs behind a reverse proxy (Vercel sets this for you).
# TRUST_PROXY=1
# Starting settings for NEW accounts (users can change them in Settings).
# DEFAULT_CURRENCY=KES
# DEFAULT_USD_TO_KES=129
# DEFAULT_SPLIT_NEEDS=50
# DEFAULT_SPLIT_WANTS=30
# DEFAULT_SPLIT_SAVINGS=20
# DEFAULT_SAVINGS_APR=0
# DEFAULT_EMERGENCY_MONTHS=3
